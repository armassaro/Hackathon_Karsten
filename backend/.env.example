# Copie para backend/.env e preencha. NUNCA versione o .env (o repositório é público).

# "local"  = arquivo JSON + código de login no console (ensaio / contingência, sem internet)
# "google" = Google Apps Script + Planilhas + envio de e-mail (arquitetura alvo)
STORE=local

PORT=3000
NODE_ENV=development

# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSAO_HORAS=8

# Primeiro administrador (modo local). No modo google, o admin vem da aba USUARIOS.
ADMIN_EMAIL=

# Modo google: URL da implantação do Apps Script (termina em /exec) e o MESMO segredo
# cadastrado em Propriedades do script > GAS_SECRET.
GAS_URL=
GAS_SECRET=

# Google Drive (opcional, funciona em qualquer STORE): implantação do apps-script-drive/Code.gs
# (URL terminada em /exec) e o MESMO segredo cadastrado lá em Propriedades do script > GAS_DRIVE_SECRET.
# Gere com `npm run segredo`; mínimo 32 caracteres e diferente do GAS_SECRET. Vazio = botão desativado no servidor.
GAS_DRIVE_URL=
GAS_DRIVE_SECRET=

# Só se o frontend rodar em outra origem (ex.: http://intranet:5173). Vazio = mesma origem.
ORIGEM_FRONTEND=

# SÓ PARA ENSAIO no modo local: mostra o código de login na tela. Nunca em produção.
DEV_EXIBIR_CODIGO=false
